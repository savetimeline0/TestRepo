{
  "info": {
    "name": "AP Simulator",
    "_postman_id": "ap-simulator-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "invoiceId", "value": "" }
  ],
  "item": [
    {
      "name": "List Invoices",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/ap/invoices", "path": ["api","ap","invoices"] }
      }
    },
    {
      "name": "Get Invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/ap/invoices/{{invoiceId}}", "path": ["api","ap","invoices","{{invoiceId}}"] }
      }
    },
    {
      "name": "Create Invoice",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"invoiceNumber\": \"INV-2026-002\",\n  \"invoiceDate\": \"2026-05-16\",\n  \"dueDate\": \"2026-06-16\",\n  \"header\": {\n    \"vendorId\": \"VENDOR-002\",\n    \"vendorName\": \"Tech Solutions Inc\",\n    \"vendorEmail\": \"billing@techsolutions.com\",\n    \"vendorPhone\": \"+1-555-0200\",\n    \"vendorAddress\": \"456 Tech Park, San Francisco, CA 94105\",\n    \"invoiceNotes\": \"Net 30 terms\"\n  },\n  \"lines\": [\n    {\n      \"description\": \"Cloud Infrastructure Services\",\n      \"quantity\": 1,\n      \"unitPrice\": 5000\n    },\n    {\n      \"description\": \"Technical Support Hours\",\n      \"quantity\": 50,\n      \"unitPrice\": 200\n    }\n  ],\n  \"summary\": {\n    \"taxRate\": 0.08\n  }\n}" },
        "url": { "raw": "{{baseUrl}}/api/ap/invoices", "path": ["api","ap","invoices"] }
      }
    },
    {
      "name": "Update Invoice",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"header\": {\n    \"invoiceNotes\": \"Updated payment terms: Net 45\"\n  },\n  \"summary\": {\n    \"taxRate\": 0.1\n  }\n}" },
        "url": { "raw": "{{baseUrl}}/api/ap/invoices/{{invoiceId}}", "path": ["api","ap","invoices","{{invoiceId}}"] }
      }
    },
    {
      "name": "Pay Invoice",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/ap/invoices/{{invoiceId}}/pay", "path": ["api","ap","invoices","{{invoiceId}}","pay"] }
      }
    },
    {
      "name": "Delete Invoice",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/ap/invoices/{{invoiceId}}", "path": ["api","ap","invoices","{{invoiceId}}"] }
      }
    }
  ]
}
